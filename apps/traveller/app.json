{
  "expo": {
    "name": "Layo",
    "slug": "layo-traveller",
    "scheme": "layo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B2545"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.layo.traveller"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2545"
      },
      "package": "com.layo.traveller",
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#2878C7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Layo needs access to your photos so you can set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0ac248cc-68ac-4682-9b0e-ad239f72ce3a"
      }
    },
    "owner": "puddu045"
  }
}
