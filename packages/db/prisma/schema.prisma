// Layo data model.
// Design notes:
// - User identity (auth-linked) is kept separate from Profile (public-facing details).
// - All timestamps for flights/journeys are stored in UTC; display-local conversion happens
//   in clients using each Airport's IANA timezone.
// - IDs are UUIDs except natural keys (IATA codes) used as primary keys for reference data.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & profile
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Server-enforced admin permission tiers (Admin Roles). `isAdmin` stays in sync with
/// `adminRole !== null` — kept as a plain boolean too since most route guards only need
/// "is this caller any kind of admin", while a handful of write actions additionally check
/// `adminRole` via `RoleGuard`.
enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  BUSINESS_MANAGER
}

/// Mirrors a Supabase Auth user. Holds only identity/account-level fields —
/// never public-facing profile content.
model User {
  id         String     @id @default(uuid()) // matches Supabase auth.users.id
  email      String     @unique
  /// E.164-ish format (e.g. +14155552671), captured but not verified — see the Settings screen.
  /// Never exposed on the public profile, same as email.
  phone      String?    @unique
  isAdmin    Boolean    @default(false)
  adminRole  AdminRole?
  status     UserStatus @default(ACTIVE)
  /// Set by an admin's "Verify" action (Users module) — a trust signal shown on the profile,
  /// independent of account status.
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  profile Profile?

  journeys               Journey[]
  ownedBusinesses        Business[]
  sentConnections        Connection[]           @relation("ConnectionRequester")
  receivedConnections    Connection[]           @relation("ConnectionAddressee")
  messages               Message[]
  roomMemberships        AirportRoomMembership[]
  roomMessages           AirportRoomMessage[]
  blocksInitiated        Block[]                 @relation("BlockBlocker")
  blocksReceived         Block[]                 @relation("BlockBlocked")
  reportsFiled           Report[]                @relation("ReportReporter")
  reportsReceived        Report[]                @relation("ReportReported")
  reportsResolved        Report[]                @relation("ReportResolvedBy")
  notifications          Notification[]
  auditLogEntries        AuditLog[]
  identitiesBanned       BannedIdentity[]
  pushTokens             PushToken[]

  @@index([status])
}

/// One row per device that registered for push notifications — a device, not a session: the
/// same physical phone keeps the same Expo push token across sign-ins, so logging in as a
/// different user on it re-points this same row's `userId` rather than creating a duplicate
/// (see `PushTokensService.register`'s upsert-by-token).
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // 'ios' | 'android'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Public-facing traveller profile. Never exposes date of birth directly — only
/// a computed age is served to other users.
model Profile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  dateOfBirth   DateTime @db.Date
  bio           String   @default("")
  photoUrl      String?
  interests     String[] @default([])
  languages     String[] @default([])
  homeCityIata  String?
  homeCity      Airport? @relation(fields: [homeCityIata], references: [iataCode])
  discoverable  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([discoverable])
}

// ---------------------------------------------------------------------------
// Reference data: airports & airlines
// ---------------------------------------------------------------------------

model Airport {
  iataCode  String   @id
  icaoCode  String?
  name      String
  city      String
  country   String
  timezone  String // IANA timezone
  latitude  Float?
  longitude Float?

  departingFlights Flight[]        @relation("DepartureAirport")
  arrivingFlights  Flight[]        @relation("ArrivalAirport")
  profilesHome     Profile[]
  room             AirportRoom?
  businesses       Business[]
  deals            Deal[]
}

model Airline {
  iataCode String  @id
  icaoCode String?
  name     String

  flights Flight[]
}

// ---------------------------------------------------------------------------
// Flights & journeys
// ---------------------------------------------------------------------------

enum FlightStatus {
  SCHEDULED
  ACTIVE
  LANDED
  CANCELLED
  DELAYED
  DIVERTED
  UNKNOWN
}

enum FlightDataSource {
  MOCK
  AVIATIONSTACK
  MANUAL
}

/// A single canonical flight instance (one airline+flight number+date+route).
/// Multiple users' journeys reference the same Flight row when they are on the
/// same flight, which is what makes "same flight" matching a simple join.
model Flight {
  id                     String           @id @default(uuid())
  airlineIataCode        String
  airline                Airline          @relation(fields: [airlineIataCode], references: [iataCode])
  flightNumber           String
  operatingFlightNumber  String?
  departureAirportIata   String
  departureAirport       Airport          @relation("DepartureAirport", fields: [departureAirportIata], references: [iataCode])
  arrivalAirportIata     String
  arrivalAirport         Airport          @relation("ArrivalAirport", fields: [arrivalAirportIata], references: [iataCode])
  scheduledDepartureUtc  DateTime
  scheduledArrivalUtc    DateTime
  departureTerminal      String?
  arrivalTerminal        String?
  status                 FlightStatus     @default(SCHEDULED)
  dataSource             FlightDataSource @default(MOCK)
  /// De-duplication key: same airline+flight number+scheduled departure date+route
  /// map to one canonical Flight row so independent journey entries converge.
  canonicalKey           String           @unique
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  segments JourneySegment[]

  @@index([departureAirportIata, scheduledDepartureUtc])
  @@index([arrivalAirportIata, scheduledArrivalUtc])
  @@index([airlineIataCode, flightNumber])
}

model Journey {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?
  isDiscoverable Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  segments JourneySegment[]

  @@index([userId])
}

model JourneySegment {
  id        String   @id @default(uuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  flightId  String
  flight    Flight   @relation(fields: [flightId], references: [id])
  sequence  Int
  createdAt DateTime @default(now())

  @@unique([journeyId, sequence])
  @@index([flightId])
}

// ---------------------------------------------------------------------------
// Connections & private messaging
// ---------------------------------------------------------------------------

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model Connection {
  id           String           @id @default(uuid())
  requesterId  String
  requester    User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId  String
  addressee    User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       ConnectionStatus @default(PENDING)
  /// Captured once, at creation (or REOPEN), from the requester's Discover match — why Layo
  /// matched these two people, kept around so it still answers "how are we connected" after
  /// the trip that caused it has passed, or if either side's journey is later edited or
  /// deleted. Never recomputed/overwritten after that; null on a connection made before this
  /// existed, or on a REOPENed connection that's seen the status flip since. Plain string, not
  /// the MatchCategory enum, matching every other "event kind" column in this schema
  /// (Notification.type, AuditLog.action) — new categories never need a migration.
  matchCategory        String?
  matchAirportIata     String?
  matchFlightNumber    String?
  matchOverlapStartUtc DateTime?
  matchOverlapEndUtc   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages Message[]

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Message {
  id           String     @id @default(uuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id])
  body         String
  createdAt    DateTime   @default(now())
  readAt       DateTime?

  @@index([connectionId, createdAt])
}

// ---------------------------------------------------------------------------
// Airport group rooms
// ---------------------------------------------------------------------------

model AirportRoom {
  airportIata  String   @id
  airport      Airport  @relation(fields: [airportIata], references: [iataCode])
  name         String
  description  String?
  /// Admin moderation: a locked room rejects new messages (existing history stays visible).
  locked       Boolean  @default(false)
  lockedReason String?
  createdAt    DateTime @default(now())

  memberships AirportRoomMembership[]
  messages    AirportRoomMessage[]
}

model AirportRoomMembership {
  id          String      @id @default(uuid())
  airportIata String
  room        AirportRoom @relation(fields: [airportIata], references: [airportIata], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The journey segment that granted access, kept so access can be re-validated/audited.
  journeySegmentId String?
  joinedAt    DateTime    @default(now())
  lastReadAt  DateTime?

  @@unique([airportIata, userId])
}

model AirportRoomMessage {
  id               String      @id @default(uuid())
  airportIata      String
  room             AirportRoom @relation(fields: [airportIata], references: [airportIata], onDelete: Cascade)
  senderId         String
  sender           User        @relation(fields: [senderId], references: [id])
  body             String
  /// Soft-removed by a moderator — hidden from the traveller-facing room, kept for audit history.
  removedAt        DateTime?
  removedByAdminId String?
  createdAt        DateTime    @default(now())

  @@index([airportIata, createdAt])
}

/// A moderator-issued, time-boxed mute from one airport room. Checked in `postMessage`
/// alongside the room's own `locked` flag.
model AirportRoomMute {
  id             String    @id @default(uuid())
  airportIata    String
  userId         String
  mutedUntil     DateTime?
  reason         String?
  mutedByAdminId String?
  createdAt      DateTime  @default(now())

  @@unique([airportIata, userId])
}

// ---------------------------------------------------------------------------
// Businesses & deals
// ---------------------------------------------------------------------------

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessCategory {
  FOOD_DRINK
  DUTY_FREE
  LOUNGE
  FASHION_RETAIL
  TRAVEL_ESSENTIALS
  SERVICES
}

model Business {
  id           String           @id @default(uuid())
  ownerUserId  String
  owner        User             @relation(fields: [ownerUserId], references: [id])
  name         String
  category     BusinessCategory
  airportIata  String
  airport      Airport          @relation(fields: [airportIata], references: [iataCode])
  contactEmail String
  status       BusinessStatus   @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  deals Deal[]

  @@index([airportIata, status])
}

enum DealCategory {
  FOOD_DRINK
  DUTY_FREE
  LOUNGE
  FASHION_RETAIL
  TRAVEL_ESSENTIALS
  SERVICES
}

enum DealStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DealLocationType {
  AIRSIDE
  LANDSIDE
  UNKNOWN
}

enum DealCreatedBy {
  ADMIN
  BUSINESS
}

model Deal {
  id                   String           @id @default(uuid())
  businessId           String
  business             Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  airportIata          String
  airport              Airport          @relation(fields: [airportIata], references: [iataCode])
  terminal             String?
  locationType         DealLocationType @default(UNKNOWN)
  category             DealCategory
  title                String
  description          String
  termsAndConditions   String?
  promoCode            String?
  validFrom            DateTime
  validUntil           DateTime
  status               DealStatus       @default(PENDING)
  createdBy            DealCreatedBy
  rejectionReason      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([airportIata, status, validUntil])
}

// ---------------------------------------------------------------------------
// Safety: blocking, reporting, moderation, notifications
// ---------------------------------------------------------------------------

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

/// Computed from the reported user's distinct-reporter count and the report's own reason
/// severity (see `computeReportPriority`) — never from one report's count in isolation, and
/// never a trigger for an automatic ban. CRITICAL means "needs review now", not "ban now".
enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Report {
  id                    String         @id @default(uuid())
  reporterId            String
  reporter              User           @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedUserId        String?
  reportedUser          User?          @relation("ReportReported", fields: [reportedUserId], references: [id])
  reportedMessageId     String?
  reportedRoomMessageId String?
  reason                String
  details               String?
  status                ReportStatus   @default(OPEN)
  priority              ReportPriority @default(LOW)
  /// Case assignment — which admin is working this report, if any.
  assignedAdminId       String?
  resolvedByAdminId     String?
  resolvedByAdmin       User?          @relation("ReportResolvedBy", fields: [resolvedByAdminId], references: [id])
  resolvedAt            DateTime?
  createdAt             DateTime       @default(now())

  @@index([status])
  @@index([priority])
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

/// A suspended/banned account can't call any authenticated endpoint (`SupabaseAuthGuard`
/// rejects them before any controller runs), so this is filed unauthenticated, by email, and
/// matched up by an admin reviewing it — not linked to one specific Report, since a ban can
/// follow from several.
model ReportAppeal {
  id                String       @id @default(uuid())
  email             String
  message           String
  status            AppealStatus @default(PENDING)
  resolvedByAdminId String?
  resolvedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@index([status])
}

/// A previously-banned account's email, checked at auth time (see SupabaseAuthGuard) so a
/// banned user can't just sign up again with the same address. `bannedByAdminId` is null when
/// the 10-distinct-reporter automation did the banning rather than a human admin action.
model BannedIdentity {
  id              String    @id @default(uuid())
  email           String    @unique
  reason          String?
  bannedAt        DateTime  @default(now())
  bannedByAdminId String?
  bannedByAdmin   User?     @relation(fields: [bannedByAdminId], references: [id])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  // Nullable: a null actor means an automated action (e.g. the 10-distinct-reporter auto-ban),
  // not a human admin — still worth logging, just with no admin to attribute it to.
  actorAdminId   String?
  actorAdmin     User?    @relation(fields: [actorAdminId], references: [id])
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Admin settings, flight diagnostics, announcements, support (Admin Portal)
// ---------------------------------------------------------------------------

/// Admin-editable runtime configuration (Settings module), keyed by category — e.g.
/// `"moderation"`, `"matching"`, `"airportChat"`, `"featureFlags"`. Each value is a partial
/// JSON object merged over that category's compiled-in defaults (see `SettingsService`), so a
/// row only needs to exist once an admin has actually changed something.
model AppSetting {
  key              String   @id
  value            Json
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}

/// Logged whenever `FlightsService.lookup` fails (provider error or no match), so admins can
/// see which flight numbers/dates travellers are failing to find without reading server logs.
model FlightLookupFailure {
  id            String   @id @default(uuid())
  flightNumber  String
  departureDate String
  reason        String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

enum AnnouncementAudience {
  ALL
  BY_AIRPORT
  SPECIFIC_USERS
}

enum AnnouncementStatus {
  SCHEDULED
  SENT
  CANCELLED
}

/// An admin-authored broadcast. Sent immediately when `scheduledAt` is unset or already past;
/// otherwise picked up by `AnnouncementsService`'s cron. Fans out to `Notification` rows
/// (type `'ANNOUNCEMENT'`) for its audience at send time.
model Announcement {
  id                String               @id @default(uuid())
  title             String
  body              String
  audience          AnnouncementAudience
  targetAirportIata String?
  targetUserIds     String[]             @default([])
  scheduledAt       DateTime?
  sentAt            DateTime?
  status            AnnouncementStatus   @default(SCHEDULED)
  createdByAdminId  String?
  createdAt         DateTime             @default(now())

  @@index([status, scheduledAt])
}

enum SupportCategory {
  BUG
  FEEDBACK
  ACCOUNT
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id              String          @id @default(uuid())
  /// Nullable: a signed-out/unauthenticated visitor can still file feedback by email.
  userId          String?
  email           String
  subject         String
  body            String
  category        SupportCategory @default(OTHER)
  status          SupportStatus   @default(OPEN)
  assignedAdminId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  replies SupportReply[]

  @@index([status])
}

model SupportReply {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Exactly one of the two is set: an admin's reply or the ticket author's own follow-up.
  authorAdminId String?
  authorUserId  String?
  body          String
  createdAt     DateTime      @default(now())

  @@index([ticketId])
}
