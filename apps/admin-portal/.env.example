NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-or-project-anon-key"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3333/api/v1"
NEXT_PUBLIC_BRAND_NAME=Layo

# Only needed to run the Playwright E2E suite (e2e/global-setup.ts creates its test account
# with it) — never used by the Next.js app itself, and never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="replace-with-local-service-role-key"
