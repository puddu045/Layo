{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false,
    "baseUrl": "./",
    "outDir": "./dist",
    "noEmit": false,
    "incremental": true
  },
  "include": ["src", "test"]
}
