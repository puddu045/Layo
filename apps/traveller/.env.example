EXPO_PUBLIC_SUPABASE_URL="http://localhost:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-or-project-anon-key"
EXPO_PUBLIC_API_BASE_URL="http://localhost:3333/api/v1"
EXPO_PUBLIC_BRAND_NAME=Layo

# Uncomment if `expo start --web` shows a crashing dev-tools overlay (LogBox/
# DevLoadingView "Invalid hook call") on Windows in this pnpm monorepo — it
# forces Expo Router's route bundles to load synchronously instead of via
# Metro's lazy/async bundle splitting, which avoids the duplicate dev-tooling
# module instance that triggers it. Not needed for iOS/Android or for
# production web builds.
# EXPO_ROUTER_IMPORT_MODE=sync
