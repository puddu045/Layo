# ---------------------------------------------------------------------------
# Root environment reference for the whole monorepo. Each app also has its own
# .env.example with just the variables it needs (apps/api, apps/traveller,
# apps/admin-portal). Copy this file to .env at the repo root if you prefer a
# single shared file for local development with `docker compose` / scripts.
#
# Never commit a real .env file. Never put a Supabase service-role key or any
# other secret in a variable prefixed NEXT_PUBLIC_ / EXPO_PUBLIC_ — those are
# bundled into client code and are effectively public.
# ---------------------------------------------------------------------------

# --- Brand (safe to rebrand the whole product by changing these) ----------
BRAND_NAME=Layo
BRAND_TAGLINE="Meet fellow travellers on your journey"
BRAND_LEGAL_NAME="Layo Technologies Ltd"
BRAND_SUPPORT_EMAIL=support@example.com

# --- Database (Postgres via local Supabase CLI, see README) ---------------
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# --- Redis (local Docker, see README) --------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Supabase ---------------------------------------------------------------
# From `supabase start` output when running locally, or your hosted project's
# Settings > API page.
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="replace-with-local-or-project-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-local-or-project-service-role-key"
SUPABASE_JWT_SECRET="replace-with-local-or-project-jwt-secret"

# --- API ---------------------------------------------------------------------
PORT=3333
NODE_ENV=development
CORS_ORIGINS="http://localhost:19006,http://localhost:3000,http://localhost:8081"
MIN_SIGNUP_AGE_YEARS=18

# --- Flight data provider ----------------------------------------------------
# "mock" (default) requires no API key and uses deterministic fixture data.
# Switch to "aviationstack" and provide a key to hit the real Aviationstack API.
FLIGHT_PROVIDER=mock
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL="https://api.aviationstack.com/v1"
FLIGHT_CACHE_TTL_SECONDS=900

# --- Discovery / matching tuning ---------------------------------------------
DISCOVERY_DEPARTURE_WINDOW_MINUTES_BEFORE=180
DISCOVERY_DEPARTURE_WINDOW_MINUTES_AFTER=30
DISCOVERY_MIN_AIRPORT_OVERLAP_MINUTES=30
AIRPORT_ROOM_ACCESS_WINDOW_HOURS_BEFORE=6
AIRPORT_ROOM_ACCESS_WINDOW_HOURS_AFTER=4

# --- Seeding ------------------------------------------------------------------
# Password assigned to demo accounts if Supabase auth-user seeding succeeds.
SEED_DEMO_PASSWORD="Passw0rd!Demo"

# --- Traveller app (Expo) — EXPO_PUBLIC_* vars are bundled into the client ---
EXPO_PUBLIC_SUPABASE_URL="http://localhost:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-or-project-anon-key"
EXPO_PUBLIC_API_BASE_URL="http://localhost:3333/api/v1"
EXPO_PUBLIC_BRAND_NAME=Layo

# --- Admin portal (Next.js) — NEXT_PUBLIC_* vars are bundled into the client -
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-or-project-anon-key"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3333/api/v1"
NEXT_PUBLIC_BRAND_NAME=Layo
